# Copy this to .env.dev (local) and .env.prod (droplet) and fill in per environment.
# NEVER commit .env.dev or .env.prod to git.

ENVIRONMENT=development        # development | production

# --- Database ---
POSTGRES_USER=siteapp
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=siteapp
DATABASE_URL=postgresql+psycopg://siteapp:devpassword@db:5432/siteapp

# --- Site ---
SITE_NAME="Your Name"
DOMAIN=localhost               # e.g. yourdomain.com in prod (used by Nginx/Certbot)
BASE_URL=http://localhost:8000 # e.g. https://yourdomain.com in prod

# --- Admin auth ---
ADMIN_SESSION_SECRET=change-me-dev-only-not-secure   # openssl rand -hex 32 for prod

# --- Shipping (initial seed values, editable later in admin dashboard) ---
DEFAULT_DOMESTIC_SHIPPING_CENTS=500
DEFAULT_INTL_SHIPPING_CENTS=1800
DEFAULT_CURRENCY=usd

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Coinbase Commerce ---
COINBASE_COMMERCE_API_KEY=
COINBASE_WEBHOOK_SHARED_SECRET=
ENABLE_CRYPTO_CHECKOUT=false   # set true once Coinbase keys are filled in

# --- Transactional email ---
EMAIL_PROVIDER=console         # console | postmark | sendgrid | ses
EMAIL_FROM="Your Name <orders@yourdomain.com>"
NOTIFY_ADMIN_EMAIL=you@yourdomain.com
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
